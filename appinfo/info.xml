<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
  <id>integration_autophish</id>
  <name>AutoPhish</name>
  <summary>Synchronize Nextcloud groups with AutoPhish target lists</summary>
  <description>Connect an AutoPhish company with a least-privilege API key and synchronize dedicated target lists from Nextcloud groups. Synchronization adds current members and removes stale list memberships.</description>
  <version>1.0.0</version>
  <licence>AGPL-3.0-or-later</licence>
  <author>AutoPhish</author>
  <namespace>IntegrationAutoPhish</namespace>
  <category>integration</category>
  <dependencies><php min-version="8.3"/><nextcloud min-version="32" max-version="32"/></dependencies>
  <background-jobs><job>OCA\IntegrationAutoPhish\BackgroundJob\SyncJob</job></background-jobs>
  <commands><command>OCA\IntegrationAutoPhish\Command\SyncCommand</command></commands>
  <repair-steps><install><step>OCA\IntegrationAutoPhish\Migration\Install</step></install><post-migration><step>OCA\IntegrationAutoPhish\Migration\Install</step></post-migration><uninstall><step>OCA\IntegrationAutoPhish\Migration\Uninstall</step></uninstall></repair-steps>
  <settings><admin>OCA\IntegrationAutoPhish\Settings\Admin</admin></settings>
</info>
