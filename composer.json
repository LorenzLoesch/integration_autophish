{
  "name": "autophish/integration-nextcloud",
  "description": "Nextcloud group to AutoPhish target-list synchronization",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "nextcloud/ocp": "^32.0",
    "symfony/console": "^7.2",
    "doctrine/dbal": "^4.2"
  },
  "autoload": {
    "psr-4": {
      "OCA\\IntegrationAutoPhish\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\IntegrationAutoPhish\\Tests\\": "tests/",
      "OCP\\": "vendor/nextcloud/ocp/OCP/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "bash scripts/lint.sh",
    "build": "bash scripts/package.sh"
  }
}
